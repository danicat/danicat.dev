#!/usr/bin/env bash
# Pre-commit security and editorial hygiene gate for danicat.dev (PUBLIC REPOSITORY)
# Fails fast and visibly if staged changes contain unpublished drafts, internal paths/hostnames, or secrets.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

STAGED_FILES=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

ERRORS=0

is_draft_frontmatter() {
  awk '
    { sub(/\r$/, "") }
    NR==1 && $0=="---" { delim="---"; in_fm=1; next }
    NR==1 && $0=="+++" { delim="+++"; in_fm=1; next }
    in_fm && $0==delim { exit !found }
    in_fm && tolower($0) ~ /^[[:space:]]*draft[[:space:]]*[:=][[:space:]]*["'\'']?true["'\'']?([[:space:]]*(#.*)?)?$/ { found=1 }
    END { exit !found }
  '
}

file_is_draft() {
  local target="$1"
  if git cat-file -e ":$target" 2>/dev/null; then
    git show ":$target" | is_draft_frontmatter
  elif [[ -f "$target" ]]; then
    is_draft_frontmatter < "$target"
  else
    return 1
  fi
}

bundle_draft_index() {
  local dir="$1"
  local candidate first_draft="" has_published=0
  # Check any staged or on-disk index*.md / _index*.md in this bundle directory.
  # Block bundle assets if the primary index.md/_index.md is a draft, or if all
  # index files in the bundle are drafts (e.g. a single-locale draft translation).
  while IFS= read -r candidate; do
    [[ -z "$candidate" ]] && continue
    if file_is_draft "$candidate"; then
      if [[ "$candidate" == "$dir/index.md" ]] || [[ "$candidate" == "$dir/_index.md" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
      [[ -z "$first_draft" ]] && first_draft="$candidate"
    else
      has_published=1
    fi
  done < <(
    {
      git -c core.quotepath=false ls-files --cached -- "$dir/index.md" "$dir/index.*.md" "$dir/_index.md" "$dir/_index.*.md" 2>/dev/null || true
      shopt -s nullglob
      for candidate in "$dir"/index.md "$dir"/index.*.md "$dir"/_index.md "$dir"/_index.*.md; do
        printf '%s\n' "$candidate"
      done
    } | awk '!seen[$0]++'
  )
  if [[ -n "$first_draft" ]] && [[ $has_published -eq 0 ]]; then
    printf '%s\n' "$first_draft"
    return 0
  fi
  return 1
}

echo "🔒 Running danicat.dev public-repo pre-commit security gate..."

# 1. Block forbidden file paths (drafts, agent configs, bytecode, databases, env files)
while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  if [[ "$file" =~ (^|/)DRAFT.*\.md$ ]] || [[ "$file" =~ ^drafts/ ]] || [[ "$file" =~ ^content/drafts/ ]] || [[ "$file" == "CONTENT_PLAN.md" ]]; then
    echo -e "${RED}[BLOCKED: DRAFT FILE]${NC} '$file' is a work-in-progress draft file and must NEVER be committed to the public repository."
    ERRORS=$((ERRORS + 1))
  fi

  if [[ "$file" =~ ^(\.gemini|\.agents|\.claude|\.issue|\.playwright-mcp|nanobanana-output)/ ]]; then
    echo -e "${RED}[BLOCKED: AGENT ARTIFACT]${NC} '$file' is a local agent workspace file and must not be committed."
    ERRORS=$((ERRORS + 1))
  fi

  if [[ "$file" =~ (__pycache__|\.pyc$|\.pyo$|\.db$|\.sqlite|\.env|\.pem$|\.key$) ]]; then
    echo -e "${RED}[BLOCKED: LOCAL ARTIFACT/SECRET]${NC} '$file' is a forbidden binary, database, or credential file."
    ERRORS=$((ERRORS + 1))
  fi

  # 2a. Block content/*.md files that still have 'draft: true' (YAML) or 'draft = true' (TOML) in frontmatter
  if [[ "$file" =~ ^content/.*\.md$ ]] && file_is_draft "$file"; then
    echo -e "${RED}[BLOCKED: UNPUBLISHED DRAFT]${NC} '$file' has 'draft: true' in frontmatter."
    echo -e "  -> Committing 'draft: true' leaks the unreviewed article in the PUBLIC GitHub commit history."
    echo -e "  -> Keep it unstaged until ready for public release with 'draft: false'."
    ERRORS=$((ERRORS + 1))
    continue
  fi

  # 2b. Block any sibling asset/file inside a page bundle whose index*.md or _index*.md is still 'draft: true'
  if [[ "$file" =~ ^content/ ]]; then
    dir=$(dirname "$file")
    while [[ "$dir" == content/*/* ]]; do
      if draft_idx=$(bundle_draft_index "$dir") && [[ "$file" != "$draft_idx" ]]; then
        echo -e "${RED}[BLOCKED: UNPUBLISHED DRAFT BUNDLE]${NC} '$file' belongs to draft bundle '$dir/' ('$draft_idx' has 'draft: true')."
        echo -e "  -> Keep all draft assets unstaged until '$draft_idx' is ready for release with 'draft: false'."
        ERRORS=$((ERRORS + 1))
        break
      fi
      dir=$(dirname "$dir")
    done
  fi
done <<< "$STAGED_FILES"

# 3. Scan staged added lines for internal hostnames, local machine paths, and secret tokens
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # Skip this script itself and GEMINI.md documentation rules
  if [[ "$file" == "scripts/pre-commit" ]] || [[ "$file" == "GEMINI.md" ]]; then
    continue
  fi

  ADDED_LINES=$(git diff --cached -U0 -- "$file" | grep -E '^\+[^+]' || true)
  [[ -z "$ADDED_LINES" ]] && continue

  # Check for internal machine hostnames / corporate domains / local home paths
  LEAK_MATCH=$(echo "$ADDED_LINES" | grep -En '(\.roam\.internal|\.corp\.google\.com|petruzalek-mac|/Users/petruzalek)' || true)
  if [[ -n "$LEAK_MATCH" ]]; then
    echo -e "${RED}[BLOCKED: INTERNAL PATH/HOSTNAME LEAK]${NC} Staged additions in '$file' contain internal workstation paths or hostnames:"
    echo "$LEAK_MATCH" | sed 's/^/  /'
    ERRORS=$((ERRORS + 1))
  fi

  # Check for credentials / API keys (excluding public Firebase web config in config/_default/params.toml)
  if [[ "$file" != "config/_default/params.toml" ]]; then
    SECRET_MATCH=$(echo "$ADDED_LINES" | grep -En '(AIza[0-9A-Za-z_-]{35}|ya29\.[0-9A-Za-z_-]+|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{82}|-----BEGIN [A-Z ]*PRIVATE KEY-----)' || true)
    if [[ -n "$SECRET_MATCH" ]]; then
      echo -e "${RED}[BLOCKED: SECRET / API KEY LEAK]${NC} Staged additions in '$file' appear to contain a credential or API key:"
      echo "$SECRET_MATCH" | sed 's/^/  /'
      ERRORS=$((ERRORS + 1))
    fi
  fi
done <<< "$STAGED_FILES"

if [[ $ERRORS -gt 0 ]]; then
  echo ""
  echo -e "${RED}❌ Pre-commit gate failed with $ERRORS error(s). Commit aborted to protect public repository.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ Pre-commit security gate passed.${NC}"
exit 0
