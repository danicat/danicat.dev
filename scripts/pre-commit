#!/usr/bin/env bash
# Pre-commit security and editorial hygiene gate for danicat.dev (PUBLIC REPOSITORY)
# Fails fast and visibly if staged changes contain unpublished drafts, internal paths/hostnames, or secrets.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

ERRORS=0

echo "🔒 Running danicat.dev public-repo pre-commit security gate..."

# 1. Block forbidden file paths (drafts, agent configs, bytecode, databases, env files)
while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  if [[ "$file" =~ (^|/)DRAFT.*\.md$ ]] || [[ "$file" =~ ^drafts/ ]] || [[ "$file" =~ ^content/drafts/ ]] || [[ "$file" == "CONTENT_PLAN.md" ]]; then
    echo -e "${RED}[BLOCKED: DRAFT FILE]${NC} '$file' is a work-in-progress draft file and must NEVER be committed to the public repository."
    ERRORS=$((ERRORS + 1))
  fi

  if [[ "$file" =~ ^(\.gemini|\.agents|\.claude|\.issue|\.playwright-mcp|nanobanana-output)/ ]]; then
    echo -e "${RED}[BLOCKED: AGENT ARTIFACT]${NC} '$file' is a local agent workspace file and must not be committed."
    ERRORS=$((ERRORS + 1))
  fi

  if [[ "$file" =~ (__pycache__|\.pyc$|\.pyo$|\.db$|\.sqlite|\.env|\.pem$|\.key$) ]]; then
    echo -e "${RED}[BLOCKED: LOCAL ARTIFACT/SECRET]${NC} '$file' is a forbidden binary, database, or credential file."
    ERRORS=$((ERRORS + 1))
  fi

  # 2. Block content/*.md files that still have 'draft: true' in frontmatter
  if [[ "$file" =~ ^content/.*\.md$ ]] && [[ -f "$file" ]]; then
    if awk 'BEGIN{in_fm=0} /^---$/{in_fm++; next} in_fm==1 && /^draft:[[:space:]]*true([[:space:]]|$)/{found=1} in_fm>=2{exit} END{exit !found}' "$file"; then
      echo -e "${RED}[BLOCKED: UNPUBLISHED DRAFT]${NC} '$file' has 'draft: true' in frontmatter."
      echo -e "  -> Committing 'draft: true' leaks the unreviewed article in the PUBLIC GitHub commit history."
      echo -e "  -> Keep it unstaged (or in content/drafts/) until ready for public release with 'draft: false'."
      ERRORS=$((ERRORS + 1))
    fi
  fi
done <<< "$STAGED_FILES"

# 3. Scan staged added lines for internal hostnames, local machine paths, and secret tokens
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # Skip this script itself and GEMINI.md documentation rules
  if [[ "$file" == "scripts/pre-commit" ]] || [[ "$file" == "GEMINI.md" ]]; then
    continue
  fi

  ADDED_LINES=$(git diff --cached -U0 -- "$file" | grep -E '^\+[^+]' || true)
  [[ -z "$ADDED_LINES" ]] && continue

  # Check for internal machine hostnames / corporate domains / local home paths
  LEAK_MATCH=$(echo "$ADDED_LINES" | grep -En '(\.roam\.internal|\.corp\.google\.com|petruzalek-mac|/Users/petruzalek)' || true)
  if [[ -n "$LEAK_MATCH" ]]; then
    echo -e "${RED}[BLOCKED: INTERNAL PATH/HOSTNAME LEAK]${NC} Staged additions in '$file' contain internal workstation paths or hostnames:"
    echo "$LEAK_MATCH" | sed 's/^/  /'
    ERRORS=$((ERRORS + 1))
  fi

  # Check for credentials / API keys (excluding public Firebase web config in config/_default/params.toml)
  if [[ "$file" != "config/_default/params.toml" ]]; then
    SECRET_MATCH=$(echo "$ADDED_LINES" | grep -En '(AIza[0-9A-Za-z_-]{35}|ya29\.[0-9A-Za-z_-]+|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{82}|-----BEGIN [A-Z ]*PRIVATE KEY-----)' || true)
    if [[ -n "$SECRET_MATCH" ]]; then
      echo -e "${RED}[BLOCKED: SECRET / API KEY LEAK]${NC} Staged additions in '$file' appear to contain a credential or API key:"
      echo "$SECRET_MATCH" | sed 's/^/  /'
      ERRORS=$((ERRORS + 1))
    fi
  fi
done <<< "$STAGED_FILES"

if [[ $ERRORS -gt 0 ]]; then
  echo ""
  echo -e "${RED}❌ Pre-commit gate failed with $ERRORS error(s). Commit aborted to protect public repository.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ Pre-commit security gate passed.${NC}"
exit 0
